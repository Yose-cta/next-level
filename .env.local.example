# =================================================================
# Next Level Landing — Template de variables de entorno
# Copiar a .env.local y rellenar los valores reales
# =================================================================

# --- Site --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nl.yosmentedigital.com

# --- Supabase ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- MercadoPago (Chile) ----------------------------------------
# Get your credentials at: https://www.mercadopago.cl/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx-server-side-only
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxx-client-safe

# --- Resend (transactional emails) ------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- WhatsApp soporte (botón flotante + email post-pago) --------
NEXT_PUBLIC_WHATSAPP_NUMBER=56935834551
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola Yoselvia! Quiero más información sobre Next Level Workshop del 16 de mayo

# --- Tracking (opcional) ----------------------------------------
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# --- Workshop info ----------------------------------------------
NEXT_PUBLIC_WORKSHOP_DATE_ISO=2026-05-16T14:00:00-04:00
